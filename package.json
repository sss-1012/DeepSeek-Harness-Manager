{
  "name": "deepseek-harness-manager",
  "version": "0.2.1",
  "description": "DeepSeek Harness 管理器 — 启动/停止 harness、插件管理、更新、诊断、余额",
  "main": "main.js",
  "author": "HS",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "screenshots": "electron . --screenshots",
    "pack": "node scripts/prepack.js && electron-builder --win nsis portable --publish never && node scripts/archive-build.js",
    "pack:dir": "node scripts/prepack.js && electron-builder --win dir --publish never",
    "archive": "node scripts/archive-build.js",
    "sync-releases": "node scripts/sync-releases.js",
    "verify-signature": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-signature.ps1",
    "verify-signature:strict": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-signature.ps1 -RequireSigned"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "semver": "^7.6.3"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.hs.deepseek-harness-manager",
    "productName": "DeepSeek-Harness-Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeepSeek Harness 管理器",
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}
